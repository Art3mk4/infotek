{
    "name": "yiisoft/books-api",
    "type": "project",
    "description": "Books Catalog REST API",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": "^8.1",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "psr/http-message": "^1.0|^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/container": "^1.0|^2.0",
        "psr/log": "^1.0|^2.0|^3.0",
        "httpsoft/http-message": "^1.0",
        "httpsoft/http-response": "^1.0",
        "firebase/php-jwt": "^6.0",
        "guzzlehttp/guzzle": "^7.0",
        "guzzlehttp/psr7": "^2.0",
        "psr/http-client": "^1.0",
        "vlucas/phpdotenv": "^5.0",
        "yiisoft/db": "^2.0",
        "yiisoft/db-pgsql": "^2.0",
        "yiisoft/active-record": "^1.1",
        "yiisoft/cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
